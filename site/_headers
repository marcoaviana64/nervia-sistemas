# Cabeçalhos de segurança (Cloudflare). SAMEORIGIN: só o próprio site da Nervia pode
# abrir estas páginas dentro de um iframe (a Área do Cliente), nenhum site de terceiros.
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# App da TV do Mídia Indoor (APK para o Downloader / navegador da TV): tipo certo e fora dos buscadores
/tv.apk
  Content-Type: application/vnd.android.package-archive
  Content-Disposition: attachment; filename="midia-indoor-nervia.apk"
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-cache

# Página do fornecedor (link de cotação, sem login): fora dos buscadores e sem Referer
/cotacao/*
  X-Robots-Tag: noindex, nofollow
  Referrer-Policy: no-referrer
